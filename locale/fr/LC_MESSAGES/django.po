msgstr "Déposez un seul fichier à la fois dans le champ correspondant."

#: templates/summarizer/file_upload.html:1
msgid "This file format is not supported here. Accepted formats: {formats}."
msgstr "Ce format n’est pas accepté ici. Formats acceptés : {formats}."

#: templates/summarizer/file_upload.html:1
msgid "This file is too large. Maximum size: {max} MB."
msgstr "Ce fichier est trop volumineux. Taille maximale : {max} Mo."

#: templates/summarizer/file_upload.html:1
