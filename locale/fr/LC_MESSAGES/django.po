msgstr "Déposez votre fichier ici ou sélectionnez-le ci-dessous"

#: templates/summarizer/file_upload.html:1
msgid "Up to %(max)s MB"
msgstr "Jusqu’à %(max)s Mo"

#: templates/summarizer/file_upload.html:1
